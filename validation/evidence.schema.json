{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azelux validation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check_id", "title", "data_label", "scope", "review_status", "generated_at", "producer_commit", "command", "sources", "coverage", "status", "rows", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "check_id": {"enum": ["V1", "V2", "V3", "V4", "V5", "V6"]},
    "title": {"type": "string", "minLength": 1},
    "data_label": {"enum": ["REAL", "SYNTHETIC"]},
    "scope": {"enum": ["spot_check", "full_check"]},
    "review_status": {"enum": ["owner_reported", "independently_reproduced"]},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "reference"], "properties": {"label": {"type": "string"}, "reference": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "incomplete"]},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case", "metric", "actual", "reference", "unit", "status"], "properties": {"case": {"type": "string"}, "metric": {"type": "string"}, "actual": {"type": ["number", "null"]}, "reference": {"type": ["number", "null"]}, "unit": {"type": "string"}, "abs_error": {"type": "number", "minimum": 0}, "tolerance": {"type": "number", "minimum": 0}, "status": {"enum": ["pass", "fail", "not_evaluated"]}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

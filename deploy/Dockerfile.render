# Build from repository root. No local data directory or named context required.
FROM python:3.12-slim AS prepared
ENV PIP_NO_CACHE_DIR=1 UV_NO_CACHE=1
RUN pip install uv==0.12.5
WORKDIR /build
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv export --locked --no-dev --no-emit-project --format requirements-txt -o requirements.txt && python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt
COPY scripts /build/scripts
COPY backend /build/backend
RUN /opt/venv/bin/python scripts/download_kernels.py --data-dir /data
RUN /opt/venv/bin/python scripts/download_dems.py --data-dir /data --skip-20m
RUN /opt/venv/bin/python scripts/prepare_dems.py --data-dir /data --far --hillshade
RUN /opt/venv/bin/python scripts/prepare_remote_tiles.py --data-dir /data
RUN /opt/venv/bin/python scripts/download_basemap.py --data-dir /data
RUN mkdir -p /data/cache /data/tiles

FROM python:3.12-slim
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 AZX_DATA_DIR=/data AZX_USE_MOCK=false PORT=10000 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN useradd --system --uid 10001 --create-home azelux
COPY --from=prepared /opt/venv /opt/venv
COPY --from=prepared --chown=azelux:azelux /data /data
WORKDIR /srv
COPY backend /srv/backend
COPY fixtures /srv/fixtures
USER azelux
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app.main:app --app-dir /srv/backend --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]

# /etc/azelux/backend.env (example; no secrets are needed by Azelux). Copy, then set the real origin.
AZX_DATA_DIR=/var/lib/azelux/data
AZX_USE_MOCK=false
# Exact browser origin(s) of the site; no "*" (TRD 10.1). Same-origin proxying still needs the real origin here.
AZX_CORS_ORIGINS=https://azelux.example.org
# Only true when nginx (or another trusted proxy) overwrites X-Forwarded-For, as in nginx-azelux.conf.example.
# Otherwise every visitor shares the proxy's address for rate limiting.
AZX_TRUST_FORWARDED_FOR=true
AZX_LOG_LEVEL=INFO

    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "gsap": "3.12.5",
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.5",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
